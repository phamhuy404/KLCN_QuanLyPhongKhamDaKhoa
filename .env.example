# ===================================================
# H2T Healthcare - Clinic Management Environment Template
# Sao chép tệp này thành .env và điền giá trị bí mật thực tế
# KHÔNG đưa tệp .env chứa thông tin bí mật lên Git repository!
# ===================================================

# Môi trường ứng dụng (development / production)
FLASK_ENV=development
FLASK_DEBUG=1

# Secret Key cho phiên làm việc (BẮT BUỘC đặt chuỗi ngẫu nhiên an toàn trong Production)
SECRET_KEY=your_super_secret_key_change_in_production_min_32_chars

# Cổng máy chủ
PORT=5000

# Cấu hình CSDL: sqlserver / mysql / sqlite
DB_ENGINE=sqlserver
SQL_SERVER_NAME=localhost

# Cấu hình SMTP gửi email thông báo
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_clinic_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=your_clinic_email@gmail.com
SMTP_SENDER_NAME="Phòng Khám Đa Khoa H2T Care"

# Tọa độ và Google Maps API
CLINIC_ADDRESS="140 Lê Trọng Tấn, Phường Tây Thạnh, Quận Tân Phú, TP. Hồ Chí Minh"
CLINIC_LATITUDE=10.806689
CLINIC_LONGITUDE=106.628581
GOOGLE_MAPS_API_KEY=
